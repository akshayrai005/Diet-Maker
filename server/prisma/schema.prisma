// NutriAI — Prisma schema.
// Phase 1: identity + encrypted health profile + versioned calc snapshots.
// Sensitive health data is stored AES-256-GCM-encrypted in `Profile.sensitiveEnc`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled — runtime
  directUrl = env("DIRECT_URL")   // direct — migrations
}

enum Role {
  user
  dietitian
  admin
}

/// Marker table proving the DB is migrated/reachable (surfaced by /ready).
model AppMeta {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_meta")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(user)

  dob      DateTime?
  gender   String? // 'male' | 'female' | other free text
  country  String?
  state    String?
  city     String?
  language String   @default("en")
  timezone String   @default("Asia/Kolkata")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // soft-delete: set on account deletion; restorable within the grace window

  profile       Profile?
  refreshTokens RefreshToken[]
  calcResults   CalcResultSnapshot[]
  auditLogs     AuditLog[]
  dietPlans     DietPlan[]
  foodLogs      FoodLog[]
  waterLogs     WaterLog[]
  checkins      WeeklyCheckin[]
  familyMembers FamilyMember[]
  exerciseLogs     ExerciseLog[]
  periodLogs       PeriodLog[]
  chatMessages     ChatMessage[]
  savedFoods       SavedFood[]
  wellnessSessions WellnessSession[]
  habits           Habit[]
  habitLogs        HabitLog[]
  reminderPrefs    ReminderPrefs?
  vitalLogs        VitalLog[]
  medications      Medication[]
  medicationLogs   MedicationLog[]
  bodyMetrics      BodyMetric[]
  bodyPhotos       BodyPhoto[]

  @@map("users")
}

/// A family member owned by a User — each has its own encrypted health profile and gets
/// its own calc/plan (a "separate AI"). Scoped to the owner via ownerId.
model FamilyMember {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  firstName       String
  relation        String? // e.g. spouse, child, parent
  heightCm        Float
  activityLevel   String   @default("moderate")
  goal            String   @default("maintain")
  dietType        String   @default("nonveg")
  reducedMobility Boolean  @default(false)
  /// AES-256-GCM JSON: sex, dob, weights, conditions, allergies, ...
  sensitiveEnc    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@map("family_members")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque refresh token — the raw token is never stored.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Non-sensitive planning inputs.
  heightCm        Float
  activityLevel   String  @default("moderate")
  goal            String  @default("maintain")
  dietType        String  @default("nonveg")
  reducedMobility Boolean @default(false)

  /// AES-256-GCM JSON: weights, measurements, vitals, conditions, allergies, etc.
  sensitiveEnc String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("profiles")
}

/// Versioned snapshot of a deterministic CalcResult (bmi/bmr/tdee/macros/flags).
model CalcResultSnapshot {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  result    Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("calc_results")
}

/// Food database (USDA + Indian seed). Per-100g macros; tags drive condition guardrails.
model Food {
  id              String   @id @default(uuid())
  name            String
  locale          String   @default("global")
  region          String?
  category        String // vegan | vegetarian | egg | nonveg
  mealSlots       String[]
  kcal            Float
  proteinG        Float
  carbG           Float
  fatG            Float
  fiberG          Float
  sugarG          Float    @default(0)
  sodiumMg        Float    @default(0)
  glycemicIndex   Int?
  typicalServingG Float    @default(100)
  costTier        Int      @default(2)
  tags            String[]
  allergens       String[]
  source          String   @default("seed")
  createdAt       DateTime @default(now())

  // Measured micronutrients per 100 g (ICMR-NIN 2020 / USDA FDC). NULL = unknown (never 0 — a
  // missing value must never become a false deficiency). The intake engine prefers these over the
  // category estimate when present. Units: *_Mg = mg, *_Mcg = mcg.
  ironMg        Float?
  calciumMg     Float?
  magnesiumMg   Float?
  potassiumMg   Float?
  zincMg        Float?
  phosphorusMg  Float?
  copperMcg     Float?
  manganeseMg   Float?
  seleniumMcg   Float?
  iodineMcg     Float?
  vitaminAMcg   Float?
  vitaminCMg    Float?
  vitaminDMcg   Float?
  vitaminEMg    Float?
  vitaminKMcg   Float?
  vitaminB1Mg   Float?
  vitaminB2Mg   Float?
  vitaminB3Mg   Float?
  vitaminB6Mg   Float?
  vitaminB12Mcg Float?
  folateMcg     Float?

  @@index([category])
  @@index([locale])
  @@map("foods")
}

/// A generated multi-day meal plan (days + the targets it was built for), stored as JSON.
model DietPlan {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      Json
  targets   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("diet_plans")
}

/// A logged food entry. Nutrition is snapshotted so history stays stable if a Food changes.
model FoodLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt    DateTime @default(now())
  mealSlot    String
  foodId      String?
  foodName    String
  grams       Float
  entryMethod String   @default("text") // text | barcode | photo | voice
  kcal        Float
  proteinG    Float
  carbG       Float
  fatG        Float
  fiberG      Float
  sugarG      Float    @default(0)
  sodiumMg    Float    @default(0)
  notes       String?
  mood        String?
  hunger      Int?
  createdAt   DateTime @default(now())

  @@index([userId, loggedAt])
  @@map("food_logs")
}

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt DateTime @default(now())
  amountMl Int

  @@index([userId, loggedAt])
  @@map("water_logs")
}

/// A completed exercise / set the user actually performed. Powers "mark workout done",
/// today's workout log, and per-exercise progression ("last time: 40 kg × 8"). Not sensitive.
model ExerciseLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  performedAt  DateTime @default(now())
  exerciseName String
  focus        String? // muscle group / day focus, e.g. "Chest"
  sets         Int?
  reps         Int?
  weightKg     Float?
  durationMin  Int? // for cardio / timed work
  kcal         Int? // estimated calories burned (server-computed, MET-based)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([userId, performedAt])
  @@index([userId, exerciseName])
  @@map("exercise_logs")
}

/// A completed mind-&-body session (yoga flow, meditation or breathing). Powers the
/// wellness streak and the calorie connection for the Move › Meditation sub-tab.
model WellnessSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // yoga | meditation | breathing
  refId       String // yoga flow / meditation content id
  refName     String
  durationMin Int
  kcal        Int      @default(0) // server-computed, MET-based
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, completedAt])
  @@map("wellness_sessions")
}

/// A tracked daily discipline habit (e.g. 10k steps, no sugar after 8pm). Per-user; defaults are
/// seeded lazily on first access. Completion is recorded per calendar day in HabitLog.
model Habit {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String // stable slug for the default set
  title     String
  icon      String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  logs      HabitLog[]

  @@unique([userId, key])
  @@index([userId])
  @@map("habits")
}

/// One day's completion of a habit (local calendar day key). Absence = not done that day.
model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD local day key
  done      Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

/// Server mirror of the user's on-device reminder preferences, so schedules survive reinstall and
/// can be reasoned about server-side. The device WorkManager remains the source of firing.
model ReminderPrefs {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealsEnabled     Boolean  @default(true)
  waterEnabled     Boolean  @default(true)
  workoutEnabled   Boolean  @default(false)
  weighInEnabled   Boolean  @default(true)
  walkEnabled      Boolean  @default(false)
  workoutTime      String? // "HH:MM" local — fires a pre-alert 10 min before
  waterIntervalMin Int      @default(60)
  updatedAt        DateTime @updatedAt

  @@map("reminder_prefs")
}

/// A logged menstrual period (start, optional end). The cycle engine self-calibrates
/// cycle length from the gaps between starts to estimate the current phase.
/// startDate/endDate are plaintext + indexed (needed for cycle-phase math + ordering; a date alone
/// is low-sensitivity). The sensitive detail — symptoms, flow, mood, notes — is AES-256-GCM-encrypted
/// (key-versioned) in `detailsEnc`, decrypted in memory only when needed. See SECURITY.md.
model PeriodLog {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate  DateTime
  endDate    DateTime?
  /// AES-256-GCM JSON: { symptoms?: string[], flow?: string, mood?: number, notes?: string }
  detailsEnc String?
  createdAt  DateTime  @default(now())

  @@index([userId, startDate])
  @@map("period_logs")
}

/// A body-measurement snapshot (physique tracking). Measurements + estimated body-fat are sensitive
/// → AES-256-GCM-encrypted in `measurementsEnc`; only `measuredAt` is plaintext for series ordering.
model BodyMetric {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt      DateTime
  /// AES-256-GCM JSON: { weightKg?, waistCm?, hipCm?, chestCm?, armCm?, thighCm?, neckCm?, bodyFatPct? }
  measurementsEnc String
  createdAt       DateTime @default(now())

  @@index([userId, measuredAt])
  @@map("body_metrics")
}

/// Metadata for a progress photo. The IMAGE ITSELF stays on-device (private, zero-cost, never
/// uploaded without the optional vision key); only this non-image record lives server-side, and an
/// optional caption is encrypted. Deleting the row + the local file removes it entirely.
model BodyPhoto {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  takenAt    DateTime
  /// Opaque client-side reference to the local encrypted file (no bytes stored server-side).
  localRef   String
  /// AES-256-GCM caption/pose note (optional).
  captionEnc String?
  createdAt  DateTime @default(now())

  @@index([userId, takenAt])
  @@map("body_photos")
}

/// A single logged health metric / lab as a time-series point. `type` + `measuredAt` are plaintext
/// (needed for series ordering + filtering; a date is low-sensitivity); the actual reading + note
/// are AES-256-GCM-encrypted in `valueEnc` (key-versioned) since labs/vitals are sensitive.
model VitalLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // VitalType (validated at app layer): bloodPressure, restingHr, fastingGlucose, hba1c, ldl, hdl, triglycerides, tsh, vitaminD, ferritin, hemoglobin, weight, waist
  unit       String
  measuredAt DateTime
  /// AES-256-GCM JSON: { value?, systolic?, diastolic?, note? }
  valueEnc   String
  createdAt  DateTime @default(now())

  @@index([userId, type, measuredAt])
  @@map("vital_logs")
}

/// A medication or supplement the user takes. Name/dose/notes/times reveal health conditions, so
/// the whole payload is AES-256-GCM-encrypted in `detailsEnc`; only the coarse `type` + `active`
/// flag (needed for filtering/scheduling) are plaintext. Kaizen never checks drug interactions.
model Medication {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // 'med' | 'supplement'
  active     Boolean  @default(true)
  /// AES-256-GCM JSON: { name, dose?, times?: string[] "HH:mm", notes? }
  detailsEnc String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  logs MedicationLog[]

  @@index([userId])
  @@map("medications")
}

/// One adherence event — "I took it". No sensitive fields beyond the FK, so stored plain.
model MedicationLog {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  takenAt      DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([userId, takenAt])
  @@index([medicationId, takenAt])
  @@map("medication_logs")
}

/// Persisted coach chat so the AI has memory across sessions. Content is not medical data;
/// stored plain and capped/read as a recent window.
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}

/// A user's saved / custom food (per-100g). Powers favourites and create-your-own for fast logging.
model SavedFood {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kcal      Float
  proteinG  Float    @default(0)
  carbG     Float    @default(0)
  fatG      Float    @default(0)
  fiberG    Float    @default(0)
  sugarG    Float    @default(0)
  sodiumMg  Float    @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_foods")
}

/// Weekly progress check-in. Weight + body measurements are AES-256-GCM-encrypted in
/// `measurementsEnc`; subjective 1–5 ratings are stored plain.
model WeeklyCheckin {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  measurementsEnc String? // { weightKg, waistCm?, chestCm?, hipCm?, ... }
  energy          Int? // 1..5
  sleepHours      Float?
  mood            Int? // 1..5
  stress          Int? // 1..5 (1 calm .. 5 very stressed)
  sleepQuality    Int? // 1..5 (1 poor .. 5 great)
  pain            Int? // 1..5
  notes           String?
  createdAt       DateTime @default(now())

  @@index([userId, date])
  @@map("weekly_checkins")
}

/// Audit trail for access to health data (required by SECURITY.md).
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("audit_logs")
}
